#!/usr/bin/env python3
"""
validate_faults.py

Phase 0 gate check: "Injected faults measurably degrade EKF RMSE in the
expected direction." (per fault_injection.py's own docstring / the pipeline
PDF's Phase 0 gate)

Runs ekf_fusion.py on:
  - baseline (no fault) for each good session
  - every fault session already generated by fault_injection.py's
    generate_all_faults()

Then checks, per (baseline_session, sensor), for noise / bias / drift / dropout:
  PRIMARY GATE: does the WORST severity's RMSE exceed the true no-fault
  baseline by >= MIN_DEGRADATION_RATIO (default 1.05x)? This is the actual
  Phase 0 gate wording ("measurably degrades RMSE in the expected
  direction") -- a real trajectory can legitimately dip once from
  measurement noise mid-severity while still clearly degrading overall, so
  strict step-by-step monotonicity is NOT required to pass.
  INFORMATIONAL ONLY: whether RMSE is ALSO strictly increasing at every
  step is reported alongside for visibility, but does not gate pass/fail.

  And separately, delay sensitivity (small/medium/large vs baseline): does
  RMSE change AT ALL? (no direction assumed -- ekf_fusion.py's sync logic
  may or may not even use timestamps in a way delay affects; see the
  confirmed finding below)

v3 changes vs v2:
  - Reviewer-flagged issue (correct, addressed): strict monotonicity as the
    sole pass/fail was too strict for a research experiment -- a single dip
    from real trajectory noise (e.g. low=0.82, medium=0.94, high=0.91,
    extreme=1.37) would fail a fault that's obviously degrading things
    overall. Split into a primary "worst severity >= threshold x baseline"
    gate plus an informational-only strict-monotonicity flag.
  - Reviewer also flagged LiDAR fault types as missing from the matrix.
    Correction, not just compliance: LiDAR faults CANNOT be meaningfully
    validated against ekf_fusion.py, because ekf_fusion.py never reads
    LiDAR/scan data at all (fuses ONLY odometry + IMU, per its own
    docstring) -- a LiDAR-faulted session run through it would be a no-op,
    producing byte-identical RMSE to baseline every time. LiDAR fault types
    belong in fault_injection.py's matrix once added, but must be validated
    against lidar_fusion.py's own RMSE output, not this script's target.
    Left as a TODO for a lidar_fusion.py-targeting extension of this script.

v2 changes vs v1:
  - Added bias/drift/dropout checks (previously only noise was checked;
    bias/drift/dropout were implemented in fault_injection.py but never
    validated at all).
  - CONFIRMED FINDING (from real VM run + reading ekf_fusion.py lines 231-265
    and fault_injection.py's inject_delay): delay faults add a uniform
    constant offset to one sensor's timestamp column. ekf_fusion.py's
    predict step only ever computes dt = timestamps[i] - timestamps[i-1]
    (consecutive difference WITHIN one already-loaded stream) -- it never
    cross-references IMU vs odom timestamps against each other. A uniform
    shift cancels out of that subtraction algebraically, so delay is
    mathematically guaranteed to have zero effect at this pipeline stage,
    regardless of severity. This is not a bug in either script -- it's a
    structural fact about this stage. The delay check below is kept (to
    catch a regression if ekf_fusion.py's sync logic ever changes) but a
    PASS is not expected here until a stage with real cross-sensor
    timestamp alignment (e.g. lidar_fusion.py) exists.

Usage:
    python3 validate_faults.py                  # run everything for real
    python3 validate_faults.py --dry-run         # synthetic RMSE stand-ins,
                                                   # no subprocess calls,
                                                   # no real data touched
    python3 validate_faults.py --skip-existing   # reuse existing
                                                   # ekf_metrics_<session>.csv
                                                   # instead of re-running
"""

import argparse
import os
import subprocess
import sys
from dataclasses import dataclass

import pandas as pd

# ---- Config: must match confirmed real values in fault_injection.py, not guesses ----
# NOTE: good sessions are now pulled LIVE from session_registry.py at runtime
# (see get_good_sessions_list() below) instead of hardcoded here, so a newly
# recorded + health-checked session is picked up automatically -- no manual
# edit needed in this file when you record new data. Same pattern
# fault_injection.py's generate_all_faults() already uses.
DRY_RUN_FALLBACK_SESSIONS = ["20260712_141740", "20260712_144326"]  # only used with --dry-run
SENSORS = ["imu", "odom"]

# Each entry: (fault_type, ordered severities, "expect_increase"?)
# Orders confirmed against fault_injection.py's *_SEVERITY dicts.
MONOTONIC_FAULTS = {
    "noise":   ["low", "medium", "high", "extreme"],
    "bias":    ["small", "medium", "large"],
    "drift":   ["slow", "medium", "fast"],
    "dropout": ["short", "medium", "long"],
}
DELAY_SEVERITIES = ["small", "medium", "large"]

LOG_DIR = os.path.expanduser("~/ws_mobile/sensor_logs")
SCRIPTS_DIR = os.path.expanduser("~/ws_mobile/scripts")
EKF_SCRIPT = os.path.join(SCRIPTS_DIR, "ekf_fusion.py")

DELAY_TOLERANCE_M = 1e-4  # below this treat RMSE as "unchanged" (float noise)
MIN_DEGRADATION_RATIO = 1.05  # worst severity must be >= 5% worse than baseline to count as "degrades"


def fault_session_name(baseline: str, sensor: str, fault_type: str, severity: str) -> str:
    return f"{baseline}_fault_{sensor}_{fault_type}_{severity}"


def get_good_sessions_list(dry_run: bool) -> list:
    """
    Pulls good sessions LIVE from session_registry.py (the same source
    fault_injection.py's generate_all_faults() already uses), so newly
    recorded + health-checked sessions are picked up automatically.

    --dry-run mode has no real session_registry.json to read (this script
    may be run outside the VM for testing), so it falls back to a fixed
    synthetic list purely for exercising the checking logic.
    """
    if dry_run:
        return list(DRY_RUN_FALLBACK_SESSIONS)

    sys.path.insert(0, SCRIPTS_DIR)
    try:
        from session_registry import get_good_sessions
    except ImportError as e:
        print(f"ERROR: couldn't import session_registry from {SCRIPTS_DIR}: {e}", file=sys.stderr)
        sys.exit(1)

    sessions = list(get_good_sessions())
    if not sessions:
        print("ERROR: session_registry.get_good_sessions() returned no sessions.", file=sys.stderr)
        sys.exit(1)
    return sessions


def metrics_path(session: str) -> str:
    return os.path.join(LOG_DIR, f"ekf_metrics_{session}.csv")


@dataclass
class RunResult:
    session: str
    rmse: float | None
    error: str | None = None


def run_ekf(session: str, skip_existing: bool, dry_run: bool, synthetic_rmse_fn=None) -> RunResult:
    mpath = metrics_path(session)

    if dry_run:
        assert synthetic_rmse_fn is not None
        return RunResult(session=session, rmse=synthetic_rmse_fn(session))

    if skip_existing and os.path.exists(mpath):
        try:
            df = pd.read_csv(mpath)
            rmse = float(df.loc[df["metric"] == "RMSE", "value_m"].iloc[0])
            return RunResult(session=session, rmse=rmse)
        except Exception as e:
            return RunResult(session=session, rmse=None, error=f"couldn't read existing metrics: {e}")

    try:
        proc = subprocess.run(
            [sys.executable, EKF_SCRIPT, session],
            cwd=SCRIPTS_DIR,
            capture_output=True,
            text=True,
            timeout=300,
        )
    except subprocess.TimeoutExpired:
        return RunResult(session=session, rmse=None, error="timed out after 300s")

    if proc.returncode != 0:
        return RunResult(
            session=session,
            rmse=None,
            error=f"exit code {proc.returncode}. stderr tail:\n{proc.stderr[-800:]}",
        )

    if not os.path.exists(mpath):
        return RunResult(
            session=session,
            rmse=None,
            error=f"script exited 0 but {mpath} not found. stdout tail:\n{proc.stdout[-800:]}",
        )

    try:
        df = pd.read_csv(mpath)
        rmse = float(df.loc[df["metric"] == "RMSE", "value_m"].iloc[0])
    except Exception as e:
        return RunResult(session=session, rmse=None, error=f"couldn't parse metrics csv: {e}")

    return RunResult(session=session, rmse=rmse)


def make_synthetic_rmse_fn():
    """
    For --dry-run: fabricate plausible RMSE numbers so the checking logic
    can be verified without touching real data.

    - noise, bias, drift: deliberately monotonic (should PASS)
    - dropout: deliberately NON-monotonic for one session (should FAIL,
      to prove the checker can actually detect that case)
    - delay: deliberately flat/no-change (should FAIL "has effect" --
      matches the real confirmed finding)
    """
    baseline_rmse = {
        "20260712_141740": 2.4722,
        "20260712_144326": 0.6480,
    }
    mult = {
        "noise":   {"low": 1.05, "medium": 1.2, "high": 1.5, "extreme": 2.1},
        "bias":    {"small": 1.1, "medium": 1.4, "large": 2.0},
        "drift":   {"slow": 1.05, "medium": 1.3, "fast": 1.8},
        "dropout": {"short": 1.1, "medium": 1.05, "long": 1.4},  # deliberately non-monotonic (medium < short)
    }

    def fn(session: str) -> float:
        if "_fault_" not in session:
            return baseline_rmse[session]

        parts = session.split("_fault_", 1)[1]
        bits = parts.split("_")
        sensor = bits[0]
        fault_type = bits[1]
        severity = "_".join(bits[2:])
        baseline = session.split("_fault_")[0]
        base = baseline_rmse[baseline]

        if fault_type == "delay":
            if baseline == "20260712_141740":
                return base + 0.00001  # effectively unchanged -> FAIL "has effect"
            else:
                return base * 1.08     # real change -> PASS

        if fault_type in mult:
            return base * mult[fault_type][severity]

        return base * 1.1

    return fn


def check_degradation(results: dict, fault_type: str, severities: list, good_sessions: list,
                       min_degradation_ratio: float = 1.05) -> list[dict]:
    """
    Checks two SEPARATE things, per (baseline, sensor):

    1. PRIMARY GATE -- "overall degradation": does the WORST severity's RMSE
       meaningfully exceed the true no-fault baseline RMSE (by at least
       min_degradation_ratio)? This is the actual Phase 0 gate wording
       ("measurably degrades RMSE in the expected direction") and is what
       determines PASS/FAIL. A single mid-severity dip from real
       measurement noise does not fail this -- only the endpoint matters.

    2. INFORMATIONAL ONLY -- "strictly monotonic": does RMSE increase at
       EVERY step, low->extreme with no dips at all? Reported alongside for
       visibility (a clean strictly-increasing curve is a nicer result and
       worth knowing about) but does NOT affect passed/failed. Real-world
       RMSE from a single trajectory can legitimately dip once from
       measurement noise while still clearly degrading overall -- requiring
       strict monotonicity as the gate would fail genuinely-working faults
       for the wrong reason.
    """
    checks = []
    for baseline in good_sessions:
        base_r = results.get(baseline)
        for sensor in SENSORS:
            rmses = []
            missing = []
            for sev in severities:
                sess = fault_session_name(baseline, sensor, fault_type, sev)
                r = results.get(sess)
                if r is None or r.rmse is None:
                    missing.append(sev)
                    rmses.append(None)
                else:
                    rmses.append(r.rmse)

            if missing or base_r is None or base_r.rmse is None:
                reason_bits = []
                if missing:
                    reason_bits.append(f"missing data for severities: {missing}")
                if base_r is None or base_r.rmse is None:
                    reason_bits.append("missing baseline RMSE")
                checks.append({
                    "fault_type": fault_type, "baseline": baseline, "sensor": sensor,
                    "values": dict(zip(severities, rmses)),
                    "passed": False,
                    "strictly_monotonic": None,
                    "degradation_ratio": None,
                    "reason": "; ".join(reason_bits),
                })
                continue

            worst_rmse = rmses[-1]
            degradation_ratio = worst_rmse / base_r.rmse if base_r.rmse > 0 else float("inf")
            overall_degrades = degradation_ratio >= min_degradation_ratio
            strictly_increasing = all(rmses[i] < rmses[i + 1] for i in range(len(rmses) - 1))

            reason = ""
            if not overall_degrades:
                reason = (f"worst severity ({severities[-1]}={worst_rmse:.4f}m) only "
                          f"{degradation_ratio:.3f}x baseline ({base_r.rmse:.4f}m) -- "
                          f"below the {min_degradation_ratio}x threshold for 'measurably degrades'")

            checks.append({
                "fault_type": fault_type, "baseline": baseline, "sensor": sensor,
                "baseline_rmse": base_r.rmse,
                "values": dict(zip(severities, rmses)),
                "passed": overall_degrades,
                "strictly_monotonic": strictly_increasing,
                "degradation_ratio": degradation_ratio,
                "reason": reason,
            })
    return checks


def check_delay_sensitivity(results: dict, good_sessions: list) -> list[dict]:
    checks = []
    for baseline in good_sessions:
        base_r = results.get(baseline)
        if base_r is None or base_r.rmse is None:
            for sensor in SENSORS:
                checks.append({
                    "fault_type": "delay", "baseline": baseline, "sensor": sensor,
                    "values": {}, "passed": False,
                    "reason": "missing baseline RMSE",
                })
            continue

        for sensor in SENSORS:
            rmses = {}
            missing = []
            for sev in DELAY_SEVERITIES:
                sess = fault_session_name(baseline, sensor, "delay", sev)
                r = results.get(sess)
                if r is None or r.rmse is None:
                    missing.append(sev)
                else:
                    rmses[sev] = r.rmse

            if missing:
                checks.append({
                    "fault_type": "delay", "baseline": baseline, "sensor": sensor,
                    "values": rmses, "passed": False,
                    "reason": f"missing data for severities: {missing}",
                })
                continue

            max_abs_diff = max(abs(v - base_r.rmse) for v in rmses.values())
            has_effect = max_abs_diff > DELAY_TOLERANCE_M
            checks.append({
                "fault_type": "delay", "baseline": baseline, "sensor": sensor,
                "baseline_rmse": base_r.rmse,
                "values": rmses,
                "max_abs_diff_from_baseline": max_abs_diff,
                "passed": has_effect,
                "reason": "" if has_effect else
                    f"RMSE unchanged vs baseline across all delay severities "
                    f"(max diff {max_abs_diff:.6f}m <= tolerance {DELAY_TOLERANCE_M}m) "
                    f"-- CONFIRMED structural: ekf_fusion.py's dt uses only "
                    f"consecutive-row differences within one stream, so a "
                    f"uniform timestamp shift cancels out algebraically. "
                    f"Not a bug; see module docstring.",
            })
    return checks


def print_report(all_checks: dict, errors: list):
    print("=" * 70)
    print("PHASE 0 FAULT VALIDATION REPORT")
    print("=" * 70)

    if errors:
        print(f"\n!! {len(errors)} run(s) failed to produce results:")
        for e in errors:
            print(f"  - {e.session}: {e.error}")

    for fault_type, checks in all_checks.items():
        if fault_type == "delay":
            header = "Delay sensitivity (does RMSE change AT ALL vs baseline?)"
        else:
            header = f"{fault_type.capitalize()} degradation (gate: worst severity >= {MIN_DEGRADATION_RATIO}x baseline)"
        print(f"\n--- {header} ---")
        for c in checks:
            status = "PASS" if c["passed"] else "FAIL"
            if fault_type == "delay":
                vals_str = ", ".join(f"{k}={v:.4f}" for k, v in c.get("values", {}).items())
                base = c.get("baseline_rmse")
                base_str = f"baseline={base:.4f}, " if base is not None else ""
                print(f"[{status}] {c['baseline']} / {c['sensor']}: {base_str}{vals_str}")
            else:
                vals_str = ", ".join(
                    f"{k}={v:.4f}" if v is not None else f"{k}=MISSING"
                    for k, v in c["values"].items()
                )
                mono = c.get("strictly_monotonic")
                mono_str = ("strictly increasing" if mono is True
                            else "NOT strictly increasing (informational only, doesn't gate)" if mono is False
                            else "n/a")
                ratio = c.get("degradation_ratio")
                ratio_str = f", ratio={ratio:.3f}x" if ratio is not None else ""
                print(f"[{status}] {c['baseline']} / {c['sensor']}: {vals_str}{ratio_str}  [{mono_str}]")
            if not c["passed"]:
                print(f"       reason: {c['reason']}")

    n_pass = sum(c["passed"] for checks in all_checks.values() for c in checks)
    n_total = sum(len(checks) for checks in all_checks.values())
    print(f"\n{n_pass}/{n_total} checks passed.")
    print("=" * 70)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true",
                     help="Use synthetic RMSE values, no subprocess calls, no real data touched.")
    ap.add_argument("--skip-existing", action="store_true",
                     help="If ekf_metrics_<session>.csv already exists, read it instead of re-running.")
    args = ap.parse_args()

    if not args.dry_run and not os.path.isdir(LOG_DIR):
        print(f"ERROR: {LOG_DIR} not found. Are you running this on the VM?", file=sys.stderr)
        sys.exit(1)

    synthetic_fn = make_synthetic_rmse_fn() if args.dry_run else None
    good_sessions = get_good_sessions_list(args.dry_run)
    print(f"Good sessions (from session_registry): {good_sessions}", file=sys.stderr)

    sessions_to_run = []
    for baseline in good_sessions:
        sessions_to_run.append(baseline)
        for sensor in SENSORS:
            for fault_type, severities in MONOTONIC_FAULTS.items():
                for sev in severities:
                    sessions_to_run.append(fault_session_name(baseline, sensor, fault_type, sev))
            for sev in DELAY_SEVERITIES:
                sessions_to_run.append(fault_session_name(baseline, sensor, "delay", sev))

    results = {}
    errors = []
    total = len(sessions_to_run)
    for i, sess in enumerate(sessions_to_run, 1):
        print(f"[{i}/{total}] running: {sess}", file=sys.stderr)
        r = run_ekf(sess, skip_existing=args.skip_existing, dry_run=args.dry_run,
                     synthetic_rmse_fn=synthetic_fn)
        results[sess] = r
        if r.error:
            errors.append(r)

    all_checks = {}
    for fault_type, severities in MONOTONIC_FAULTS.items():
        all_checks[fault_type] = check_degradation(results, fault_type, severities, good_sessions,
                                                     min_degradation_ratio=MIN_DEGRADATION_RATIO)
    all_checks["delay"] = check_delay_sensitivity(results, good_sessions)

    print_report(all_checks, errors)


if __name__ == "__main__":
    main()
